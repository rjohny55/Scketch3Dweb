# No environment variables are required for local development.

# Optional administrator-managed update trigger. Keep these server-side; never
# prefix them with NEXT_PUBLIC_. The trigger must preserve /data/projects.
# SCKETCH3DWEB_UPDATE_TRIGGER_URL=https://updater.internal/scketch3dweb
# SCKETCH3DWEB_UPDATE_ADMIN_KEY=replace-with-a-long-random-key
# SCKETCH3DWEB_UPDATE_TRIGGER_TOKEN=optional-internal-service-token
